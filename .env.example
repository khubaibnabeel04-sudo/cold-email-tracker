# Copy this file to .env and fill in your own values. Never commit .env.

# ── Backend (server/) ─────────────────────────────
# YouTube Data API v3 key (Google Cloud Console → APIs & Services → Credentials)
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE
# Optional second key used only by the data-collection pipeline (splits quota); falls back to YOUTUBE_API_KEY
YOUTUBE_DATA_API_KEY=

# ID of the Google Sheet used as the lead source (the long ID in the sheet URL)
GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID_HERE

# One or more Groq API keys, comma-separated — the server rotates to the next key
# when one hits its daily quota
GROQ_API_KEYS=YOUR_GROQ_API_KEY_HERE

# Optional: full path to yt-dlp if it isn't on your PATH (used for transcripts)
YTDLP_PATH=

# The Google service-account JSON is NOT an env var: save it as
#   server/keys/google-service-account.json   (the whole server/keys/ folder is gitignored)
# and share your Google Sheet with the service account's client_email.

# The Gmail OAuth Client ID / Client Secret are entered in the app's Settings page
# and stored locally in server/data.json (gitignored).

# ── Frontend (React, must start with REACT_APP_) ──
# Optional: sender account pre-selected on the Draft Scheduler page
REACT_APP_PREFERRED_SENDER=you@example.com
